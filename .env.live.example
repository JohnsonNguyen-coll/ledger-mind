# LedgerMind — mẫu cấu hình PREMIUM / THANH TOÁN THẬT.
# Chưa sẵn sàng chỉ bằng việc copy file: cần CLI, ví đã kết nối và API key.
# npm run setup:live tạo .env.live và điền đường dẫn CLI nếu tìm thấy.
# Hoặc copy thành .env.live, tự điền BAW_CLI_JS và key cho AGENT_MODE đã chọn.
# Kiểm tra chỉ đọc: npm run check:live (không ký, không thanh toán).
# Khởi chạy: npm run build, sau đó npm run start:live.
# npm start thông thường không tự đọc .env.live.
# Không điền private key/seed phrase; kết nối ví qua Binance Agentic Wallet.
# Mẫu này dành cho tác vụ Binance Agentic Wallet ở backend.
# Luồng RainbowKit trên dashboard không cần BAW_CLI_JS hay model API key.
PORT=3001
DATABASE_PATH=./data/alphamesh-live.sqlite
AGENT_MODE=openrouter
MARKET_MODE=binance
PAYMENT_MODE=binance
REAL_PAYMENTS_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Entry JavaScript tuyệt đối, ví dụ C:/tools/agentic-wallet/dist/index.js.
# Ví của CLI trên backend phải có trạng thái CONNECTED.
BAW_CLI_JS=

# Merchant policy hiện cấu hình CMC: 0.01 USDC trên Base (chain ID 8453).
# Đây là mức code cho phép, phải khớp payment requirements khi kiểm tra live.
# Ví thanh toán cần số dư USDC trên Base và phải qua bước preview của adapter.
# Đây là hạn mức app, không phải số dư ví và không gồm phí OpenAI.
MOCK_WALLET_USD=0.10
MAX_PAYMENT_USD=0.01
DAILY_BUDGET_USD=0.10
MAX_TASK_BUDGET_USD=0.01
MAX_AGENT_STEPS=8
DEMO_STEP_MS=0

BROWSER_PREMIUM_ENABLED=true
# Project ID công khai để bật WalletConnect / QR; để trống vẫn dùng ví extension.
WALLETCONNECT_PROJECT_ID=

# Legacy API: usePremiumData yêu cầu dữ liệu; authorizePremiumPayment đồng ý chi tiêu.
# queued chỉ nghĩa là tác vụ đã được tạo; không chứng minh thanh toán thành công.
# Backend trả premiumData.taskId; GET /api/tasks/:id để kiểm tra tác vụ.

# Direct Google AI Studio provider (AGENT_MODE=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
