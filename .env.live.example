# Chế độ agent dùng model miễn phí qua OpenRouter và thanh toán dữ liệu thật.
# Dùng npm run setup:live để tạo .env.live và tự điền đường dẫn CLI.
PORT=3001
DATABASE_PATH=./data/alphamesh-live.sqlite
AGENT_MODE=openrouter
MARKET_MODE=binance
PAYMENT_MODE=binance
REAL_PAYMENTS_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
BAW_CLI_JS=

# Budget mua CMC: 1 USDC = 1 USD danh nghĩa. Mỗi lần mua 0.01 USDC.
# Đây là hạn mức app, không phải số dư ví và không gồm phí OpenAI.
MOCK_WALLET_USD=0.10
MAX_PAYMENT_USD=0.01
DAILY_BUDGET_USD=0.10
MAX_TASK_BUDGET_USD=0.01
MAX_AGENT_STEPS=8
DEMO_STEP_MS=0

# Direct Google AI Studio provider (AGENT_MODE=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
