# Chạy demo ngay: không cần API key, không dùng tiền thật.
PORT=3000
WHALE_PORT=4101
SENTIMENT_PORT=4102
RISK_PORT=4103
DATABASE_PATH=./data/alphamesh.sqlite
AGENT_MODE=demo
MARKET_MODE=fixture
PAYMENT_MODE=mock
MOCK_WALLET_USD=10.00
MAX_PAYMENT_USD=0.10
DAILY_BUDGET_USD=1.00
MAX_TASK_BUDGET_USD=1.00
DEMO_STEP_MS=350

# Agent thật (tính phí OpenAI riêng, KHÔNG nằm trong ngân sách mua data).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OpenRouter: đặt AGENT_MODE=openrouter; key chỉ gửi tới openrouter.ai.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
MAX_AGENT_STEPS=8

# Binance: mặc định chỉ dùng qua script preview; xem docs/BINANCE.md.
# Đường dẫn tuyệt đối đến entry .js/.mjs/.cjs của CLI, không phải baw.cmd.
BAW_CLI_JS=
# Bật real adapter CHỈ sau khi đã thêm merchant đã xác minh vào registry.
# PAYMENT_MODE=binance
REAL_PAYMENTS_ENABLED=false

# Direct Google AI Studio provider (AGENT_MODE=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
