# LedgerMind — cấu hình local / phân tích ví công khai.
# Copy file này thành .env tại thư mục gốc, sau đó npm run build && npm start.
# Không cần API key hay kết nối ví cho phân tích treasury cơ bản.
# RPC, Blockscout và ticker Binance vẫn gọi mạng thật; fixture chỉ áp dụng task runner.
# Premium ví trình duyệt: cấu hình bên dưới; xem backend/docs/X402.md.
# Không đặt private key, seed phrase hay wallet session vào file này.
PORT=3000
WHALE_PORT=4101
SENTIMENT_PORT=4102
RISK_PORT=4103
DATABASE_PATH=./data/alphamesh.sqlite
AGENT_MODE=demo
MARKET_MODE=fixture
PAYMENT_MODE=mock
MOCK_WALLET_USD=10.00
# Các giá trị bên dưới là ngân sách nội bộ của app, không phải số dư ví onchain.
MAX_PAYMENT_USD=0.10
DAILY_BUDGET_USD=1.00
MAX_TASK_BUDGET_USD=1.00
DEMO_STEP_MS=350

# Agent thật (tính phí OpenAI riêng, KHÔNG nằm trong ngân sách mua data).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OpenRouter: đặt AGENT_MODE=openrouter; key chỉ gửi tới openrouter.ai.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
MAX_AGENT_STEPS=8

# Ví trả phí là Binance Agentic Wallet trên máy chạy backend.
# Địa chỉ ví nhập để phân tích KHÔNG tự trở thành ví thanh toán.
# Dashboard dùng RainbowKit cho ví trình duyệt; không cần CLI bên dưới.
# Đường dẫn tuyệt đối đến entry .js/.mjs/.cjs của CLI, không phải baw.cmd.
BAW_CLI_JS=
# Real adapter kiểm tra merchant policy trong backend/src/services/registry.ts.
# Chỉ bật qua cấu hình live khi đã chủ động cấu hình ví và thanh toán.
# PAYMENT_MODE=binance
REAL_PAYMENTS_ENABLED=false

# RainbowKit: ví extension hoạt động không cần project ID.
# Nhập project ID công khai từ dashboard.reown.com để bật WalletConnect / QR mobile.
# Đây không phải API secret. Không đặt private key vào bất kỳ biến frontend nào.
WALLETCONNECT_PROJECT_ID=
# Cho phép báo giá và gửi chữ ký do người dùng xác nhận trong ví trình duyệt.
# Độc lập với PAYMENT_MODE/REAL_PAYMENTS_ENABLED của ví Binance ở backend.
BROWSER_PREMIUM_ENABLED=true

# Direct Google AI Studio provider (AGENT_MODE=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
