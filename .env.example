# LedgerMind — Cấu hình môi trường.
# Copy file này thành .env tại thư mục gốc, sau đó npm run build && npm start.

PORT=3000

# Supabase PostgreSQL (dùng khi deploy Cloud / Vercel / Render / Railway):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq Free API Key (Dùng Llama-3.3-70b-versatile miễn phí từ console.groq.com)
GROQ_API_KEY=

# RainbowKit WalletConnect Project ID (Tùy chọn cho ví điện thoại QR)
WALLETCONNECT_PROJECT_ID=
BROWSER_PREMIUM_ENABLED=true
