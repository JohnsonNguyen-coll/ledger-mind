# LedgerMind — Environment Configuration
# Copy this file to .env in the root directory, then run `npm run build && npm start`.

PORT=3000
# Set on Railway when the frontend proxies API requests through Vercel.
# Exact frontend origin, no trailing slash. Leave blank for direct localhost usage.
APP_ORIGIN=
# Production: APP_ORIGIN=https://ledger-mind-kappa.vercel.app

# Supabase Cloud Database Configuration:
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Model Provider (Groq Free Cloud LPU or deterministic demo mode):
# AGENT_MODE=groq
AGENT_MODE=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Premium x402 & Wallet Settings:
BROWSER_PREMIUM_ENABLED=true
WALLETCONNECT_PROJECT_ID=

# Binance Agentic Wallet Configuration (Optional backend real payments mode):
PAYMENT_MODE=mock
REAL_PAYMENTS_ENABLED=false
# BAW_CLI_JS=
