# LedgerMind — Cấu hình môi trường.
# Copy file này thành .env tại thư mục gốc, sau đó chạy `npm run build && npm start`.

PORT=3000
# Set on Railway when the frontend proxies API requests through Vercel.
# Exact frontend origin, no trailing slash. Leave blank for direct localhost usage.
APP_ORIGIN=
# Production: APP_ORIGIN=https://ledger-mind-kappa.vercel.app

# Database Configuration (SQLite mặc định local, Supabase PostgreSQL cho Cloud Vercel/Railway):
DATABASE_PATH=./data/ledgermind.sqlite
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# AI Model Provider (Mặc định dùng Groq Free API hoặc tùy chọn OpenAI / OpenRouter / Gemini):
AGENT_MODE=demo
GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# Premium x402 & Wallet Settings:
BROWSER_PREMIUM_ENABLED=true
# WALLETCONNECT_PROJECT_ID=

# Cấu hình Binance Agentic Wallet (Chế độ Real Payments Backend tùy chọn):
PAYMENT_MODE=mock
REAL_PAYMENTS_ENABLED=false
# BAW_CLI_JS=
